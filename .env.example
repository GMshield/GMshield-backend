# Every setting the backend reads, with its default or an example. README.md ("Settings") explains each.
# Nothing loads this file on its own: on roberto-server the pipeline injects the settings from
# .gmshield/pipeline.toml and the secrets from ~/gmshield-ci/secrets/backend.env (written by
# GMshield-pipeline deploy/data-credentials.sh). To run by hand, copy it to .env (git-ignored), fill in
# the secrets and pass it with `docker run --env-file .env`. For the shared development setup use
# dev/.env.example instead. Secrets are left empty here and never committed.

# PostgreSQL
GMSHIELD_DB_URL=jdbc:postgresql://postgres:5432/gmshield
GMSHIELD_DB_USER=gmshield_backend
GMSHIELD_DB_PASSWORD=

# Redis (TLS verified against /run/gmshield/certs/ca.crt; false only in the development setup)
GMSHIELD_REDIS_HOST=redis
GMSHIELD_REDIS_PORT=6379
GMSHIELD_REDIS_USERNAME=backend
GMSHIELD_REDIS_PASSWORD=
GMSHIELD_REDIS_TLS=true

# Encryption at rest: two different keys of 32 random bytes in Base64 (`openssl rand -base64 32`).
# Losing or changing the master key loses every stored value.
GMSHIELD_VAULT_MASTER_KEY=
GMSHIELD_VAULT_INDEX_KEY=
GMSHIELD_FILES_DIR=/var/lib/gmshield/files

# Sign-in with Google. The public URL is the frontend's origin (https; plain http only on localhost);
# Google redirects to <it>/auth/google/callback.
GMSHIELD_GOOGLE_CLIENT_ID=
GMSHIELD_GOOGLE_CLIENT_SECRET=
GMSHIELD_PUBLIC_URL=https://gmshield.example

# Service credentials: 32 to 512 characters of A-Z a-z 0-9 . _ ~ + / = -, each different.
# The frontend's and the worker's .env carry the same values.
GMSHIELD_FRONTEND_CREDENTIAL=
GMSHIELD_WORKER_CREDENTIAL=

# Jobs (Spring durations: 10s, 2m, PT2M)
GMSHIELD_JOB_CLAIM_LAPSE=90s
GMSHIELD_JOB_RENEW_EVERY=30s
GMSHIELD_JOB_MAX_ATTEMPTS=3
GMSHIELD_JOB_REOFFER_AFTER=2m
GMSHIELD_JOB_SWEEP_EVERY=10s
# The files a worker sends back (Spring data sizes: 3GB, 8GB), and the ingestion chain's step cap per page
GMSHIELD_JOB_OUTPUT_MAX_BYTES=3GB
GMSHIELD_JOB_OUTPUT_CLAIM_MAX_BYTES=8GB
GMSHIELD_INGESTION_STEPS_PER_PAGE=4

# Sessions: overlap < renew-after < idle timeout <= absolute timeout
GMSHIELD_SESSION_RENEW_AFTER=15m
GMSHIELD_SESSION_OVERLAP=60s
GMSHIELD_SESSION_IDLE_TIMEOUT=24h
GMSHIELD_SESSION_ABSOLUTE_TIMEOUT=7d

# Unset, or `test` (set only by the pipeline; test mode refuses to start beside the secrets above)
# GMSHIELD_MODE=test
