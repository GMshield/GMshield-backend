# Overrides for the shared development setup. Copy to dev/.env (git-ignored): Docker Compose reads it
# when dev/start runs, so these need not be exported in the shell. Every other development value is a
# throwaway set in compose.yaml. Leave a line commented to keep its default.

# Real sign-in with Google (a placeholder otherwise, and sign-in with Google fails)
# GMSHIELD_GOOGLE_CLIENT_ID=
# GMSHIELD_GOOGLE_CLIENT_SECRET=

# The worker's model provider: Azure OpenAI's key and its resource's v1 URL (placeholders otherwise), and the
# backend's choice of provider (azure-openai by default; anthropic needs GMSHIELD_ANTHROPIC_API_KEY)
# GMSHIELD_AZURE_OPENAI_API_KEY=
# GMSHIELD_AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# GMSHIELD_ANTHROPIC_API_KEY=
# GMSHIELD_MODEL_PROVIDER=azure-openai

# Short session timings, to watch renewal and expiry
# GMSHIELD_SESSION_RENEW_AFTER=20s
# GMSHIELD_SESSION_OVERLAP=5s
# GMSHIELD_SESSION_IDLE_TIMEOUT=2m
# GMSHIELD_SESSION_ABSOLUTE_TIMEOUT=7d

# Ports on 127.0.0.1, when one is taken
# GMSHIELD_DEV_BACKEND_PORT=8080
# GMSHIELD_DEV_FRONTEND_PORT=3000
# GMSHIELD_DEV_POSTGRES_PORT=5432
# GMSHIELD_DEV_REDIS_PORT=6379
# GMSHIELD_DEV_QDRANT_PORT=6333
